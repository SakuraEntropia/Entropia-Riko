{
  "version": "1.0",
  "metadata": {
    "name": "mnist",
    "description": "MNIST model block (structure): graph_input(1×28×28) → conv/relu/pool ×2 → flatten → linear → 10 class logits. Used as the `module` structure for load-from-model, and importable by training graphs.",
    "inputs": [{"name": "image", "data_kind": "tensor"}],
    "outputs": [{"name": "class", "data_kind": "tensor"}]
  },
  "nodes": [
    {"id":"gin","type_name":"graph_input","label":"Digit Image","category":"Subgraph","position":[50,150],"parameters":{"name":"image"},"inputs":[],"outputs":[]},
    {"id":"c1","type_name":"conv2d","label":"Conv 1→16","category":"Neural","position":[250,100],"parameters":{"in_channels":1,"out_channels":16,"kernel_size":3,"stride":1,"padding":1},"inputs":[],"outputs":[]},
    {"id":"r1","type_name":"relu","label":"ReLU","category":"Neural","position":[400,100],"parameters":{"device":"cpu"},"inputs":[],"outputs":[]},
    {"id":"p1","type_name":"maxpool2d","label":"MaxPool","category":"Neural","position":[550,100],"parameters":{"kernel_size":2},"inputs":[],"outputs":[]},
    {"id":"c2","type_name":"conv2d","label":"Conv 16→32","category":"Neural","position":[700,100],"parameters":{"in_channels":16,"out_channels":32,"kernel_size":3,"stride":1,"padding":1},"inputs":[],"outputs":[]},
    {"id":"r2","type_name":"relu","label":"ReLU","category":"Neural","position":[850,100],"parameters":{"device":"cpu"},"inputs":[],"outputs":[]},
    {"id":"p2","type_name":"maxpool2d","label":"MaxPool","category":"Neural","position":[1000,100],"parameters":{"kernel_size":2},"inputs":[],"outputs":[]},
    {"id":"f","type_name":"flatten","label":"Flatten","category":"Shape","position":[1150,100],"parameters":{"start_dim":1,"end_dim":-1,"device":"cpu"},"inputs":[],"outputs":[]},
    {"id":"l","type_name":"linear","label":"Linear 1568→10","category":"Neural","position":[1300,100],"parameters":{"in_features":1568,"out_features":10},"inputs":[],"outputs":[]},
    {"id":"gout","type_name":"graph_output","label":"Class Logits","category":"Subgraph","position":[1500,100],"parameters":{"name":"class"},"inputs":[],"outputs":[]}
  ],
  "edges": [
    {"id":"e0","source_node":"gin","source_port":"value","target_node":"c1","target_port":"x"},
    {"id":"e1","source_node":"c1","source_port":"result","target_node":"r1","target_port":"x"},
    {"id":"e2","source_node":"r1","source_port":"output","target_node":"p1","target_port":"x"},
    {"id":"e3","source_node":"p1","source_port":"result","target_node":"c2","target_port":"x"},
    {"id":"e4","source_node":"c2","source_port":"result","target_node":"r2","target_port":"x"},
    {"id":"e5","source_node":"r2","source_port":"output","target_node":"p2","target_port":"x"},
    {"id":"e6","source_node":"p2","source_port":"result","target_node":"f","target_port":"x"},
    {"id":"e7","source_node":"f","source_port":"result","target_node":"l","target_port":"x"},
    {"id":"e8","source_node":"l","source_port":"output","target_node":"gout","target_port":"value"}
  ],
  "settings": {}
}
